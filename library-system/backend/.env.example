# App Configuration
APP_NAME=Library Management System
DEBUG=true

# Database Configuration
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=librarydb

# JWT Configuration
JWT_SECRET_KEY=your_secret_key_here_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880


# Server Configuration
HOST=0.0.0.0
PORT=8000
