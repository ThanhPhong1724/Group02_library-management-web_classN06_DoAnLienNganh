<mxfile host="app.diagrams.net">
  <diagram id="use-case-chatbot" name="Use-case Chatbot">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Actor -->
        <mxCell id="actor-user" value="Người dùng&#xa;(User)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="30" height="60" as="geometry" />
        </mxCell>
        
        <!-- System boundary -->
        <mxCell id="system-boundary" value="Hệ thống Quản lý Thư viện" style="swimlane;html=1;startSize=20;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="800" height="400" as="geometry" />
        </mxCell>
        
        <!-- Main use case -->
        <mxCell id="uc-chatbot" value="Tương tác chatbot" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="system-boundary">
          <mxGeometry x="300" y="60" width="200" height="80" as="geometry" />
        </mxCell>
        
        <!-- Include use cases -->
        <mxCell id="uc-search-books" value="Tra cứu sách theo nhu cầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="system-boundary">
          <mxGeometry x="80" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="uc-view-location" value="Xem vị trí sách" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="system-boundary">
          <mxGeometry x="300" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="uc-check-inventory" value="Kiểm tra tồn kho" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="system-boundary">
          <mxGeometry x="520" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="uc-ask-policy" value="Hỏi quy định mượn / gia hạn / phạt" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="system-boundary">
          <mxGeometry x="200" y="280" width="280" height="60" as="geometry" />
        </mxCell>
        
        <!-- Relationship from User to main use case -->
        <mxCell id="rel-user-chatbot" value="" style="endArrow=plain;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor-user" target="uc-chatbot">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <!-- Include relationships -->
        <mxCell id="include-search-books"
                value="&lt;&lt;include&gt;&gt;"
                style="endArrow=plain;rounded=0;html=0;
                        exitX=0.25;exitY=1;exitDx=0;exitDy=0;
                        entryX=0.5;entryY=0;entryDx=0;entryDy=0;
                        dashed=1;labelPosition=center;
                        verticalLabelPosition=middle;
                        align=center;verticalAlign=middle;
                        fontStyle=1;fontSize=10;"
                edge="1" parent="system-boundary"
                source="uc-chatbot" target="uc-search-books">
            <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="include-view-location"
                value="&lt;&lt;include&gt;&gt;"
                style="endArrow=plain;rounded=0;html=0;
                        exitX=0.5;exitY=1;exitDx=0;exitDy=0;
                        entryX=0.5;entryY=0;entryDx=0;entryDy=0;
                        dashed=1;labelPosition=center;
                        verticalLabelPosition=middle;
                        align=center;verticalAlign=middle;
                        fontStyle=1;fontSize=10;"
                edge="1" parent="system-boundary"
                source="uc-chatbot" target="uc-view-location">
            <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="include-check-inventory"
                value="&lt;&lt;include&gt;&gt;"
                style="endArrow=plain;rounded=0;html=0;
                        exitX=0.75;exitY=1;exitDx=0;exitDy=0;
                        entryX=0.5;entryY=0;entryDx=0;entryDy=0;
                        dashed=1;labelPosition=center;
                        verticalLabelPosition=middle;
                        align=center;verticalAlign=middle;
                        fontStyle=1;fontSize=10;"
                edge="1" parent="system-boundary"
                source="uc-chatbot" target="uc-check-inventory">
            <mxGeometry relative="1" as="geometry" />
