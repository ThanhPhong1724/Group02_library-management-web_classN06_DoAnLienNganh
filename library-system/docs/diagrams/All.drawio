  <diagram id="i5WrIqSjZ__5ssY_9UFi" name="Page-13">
    <mxGraphModel dx="2230" dy="830" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\nclass Loan {\n  -BigInteger id\n  -BigInteger id_ban_sao\n  -BigInteger id_nguoi_dung\n  -Enum trang_thai\n  -DateTime muon_luc\n  -DateTime han_tra\n  -DateTime tra_luc\n  -Numeric so_tien_phat\n  -Text noi_dung_phat\n  -Boolean da_nop_phat\n}\n\nclass Copy {\n  -BigInteger id\n  -BigInteger id_sach\n  -String ma_ban_sao\n  -Enum trang_thai\n}\n\nclass User {\n  -BigInteger id\n  -String email\n  -Enum loai_nguoi_dung\n  -Boolean hoat_dong\n}\n\nclass Policy {\n  -Enum loai_nguoi_dung\n  -Integer toi_da_muon\n  -Integer so_ngay_muon\n  -Numeric phat_moi_ngay\n  -Integer so_lan_gia_han\n}\n\nclass Book {\n  -BigInteger id\n  -Text tieu_de\n}\n\nLoan \&quot;n\&quot; --&gt; \&quot;1\&quot; Copy : mượn bản sao\nLoan \&quot;n\&quot; --&gt; \&quot;1\&quot; User : người mượn\nLoan \&quot;n\&quot; --&gt; \&quot;1\&quot; Policy : áp dụng chính sách\nCopy \&quot;n\&quot; --&gt; \&quot;1\&quot; Book : thuộc sách\n\nnote right of Loan\n  Trạng thái: requested, rejected,\n  borrowed, return_requested,\n  returned, overdue\nend note\n\nnote right of Policy\n  Chính sách khác nhau\n  theo loại người dùng\nend note\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="8yzpnpaoIHqcZ4IVnz63-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
