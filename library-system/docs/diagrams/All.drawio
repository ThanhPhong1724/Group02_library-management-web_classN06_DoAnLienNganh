    <mxGraphModel dx="1403" dy="830" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\nclass Book {\n  -BigInteger id\n  -Text tieu_de\n  -Text tieu_de_phu\n  -Text tac_gia\n  -BigInteger id_nxb\n  -Integer nam_xb\n  -String ngon_ngu\n  -Text the_loai\n  -Text mo_ta\n  -DECIMAL gia_bia\n  -String don_vi_tien\n  -Integer so_luong_tong\n  -Integer so_luong_con\n}\n\nclass Publisher {\n  -BigInteger id\n  -String ten\n  -String dia_chi\n  -String website\n  -Text ghi_chu\n}\n\nclass BookImage {\n  -BigInteger id\n  -BigInteger id_sach\n  -Text url_anh\n  -Boolean la_anh_dai_dien\n  -Integer thu_tu\n}\n\nclass Copy {\n  -BigInteger id\n  -BigInteger id_sach\n  -String ma_ban_sao\n  -BigInteger id_vi_tri\n  -Enum trang_thai\n}\n\nclass Location {\n  -BigInteger id\n  -String ma_ke\n  -String tang\n  -String phong\n  -String ke\n  -String hang\n  -String cot\n}\n\nBook \&quot;1\&quot; --&gt; \&quot;*\&quot; Copy : có bản sao\nBook \&quot;1\&quot; --&gt; \&quot;*\&quot; BookImage : có ảnh\nBook \&quot;n\&quot; --&gt; \&quot;1\&quot; Publisher : thuộc NXB\nCopy \&quot;n\&quot; --&gt; \&quot;1\&quot; Location : ở vị trí\n\nnote right of Book\n  Số lượng tự động cập nhật\n  qua triggers khi thêm/sửa/xóa Copy\nend note\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="IzmyMNH5f8PWGC5NsV94-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
