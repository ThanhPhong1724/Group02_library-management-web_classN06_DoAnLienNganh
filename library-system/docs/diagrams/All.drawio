  <diagram id="WR2SBsR3fzERZlfDEKpf" name="Page-14">
    <mxGraphModel dx="2478" dy="2145" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n!theme plain\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 14\n\nskinparam sequence {\n  ParticipantFontName \&quot;Times New Roman\&quot;\n  ParticipantFontSize 14\n  MessageFontName \&quot;Times New Roman\&quot;\n  TitleFontName \&quot;Times New Roman\&quot;\n}\n\nautonumber\n\nactor User\nparticipant \&quot;Frontend\\n(Next.js)\&quot; as Frontend\nparticipant \&quot;Auth Router\\n(/api/auth)\&quot; as AuthRouter\nparticipant \&quot;AuthService\&quot; as AuthService\nparticipant \&quot;Database\\n(MySQL)\&quot; as DB\n\nUser -&gt; Frontend: Nhập email và password\nFrontend -&gt; AuthRouter: POST /api/auth/login\\n{email, password}\nAuthRouter -&gt; DB: SELECT user WHERE email\nDB --&gt; AuthRouter: User data\nAuthRouter -&gt; AuthService: verify_password(plain, hash)\nAuthService --&gt; AuthRouter: true/false\n\nalt Mật khẩu đúng\n    AuthRouter -&gt; AuthService: create_access_token(user_id, role, user_type)\n    AuthService -&gt; AuthService: Tạo JWT payload\n    AuthService --&gt; AuthRouter: access_token\n    AuthRouter -&gt; AuthService: create_refresh_token(user_id, role, user_type)\n    AuthService --&gt; AuthRouter: refresh_token\n    AuthRouter --&gt; Frontend: {access_token, refresh_token}\n    Frontend -&gt; Frontend: Lưu token vào localStorage\n    Frontend -&gt; AuthRouter: GET /api/auth/me\\n(Header: Bearer token)\n    AuthRouter -&gt; DB: SELECT user WHERE id\n    DB --&gt; AuthRouter: User info\n    AuthRouter --&gt; Frontend: {id, email, full_name, role, user_type}\n    Frontend -&gt; Frontend: Lưu user info vào context\n    alt Role = admin\n        Frontend -&gt; Frontend: Redirect to /admin\n    else Role = user\n        Frontend -&gt; Frontend: Redirect to /\n    end\n    Frontend --&gt; User: Hiển thị trang chủ/Dashboard\nelse Mật khẩu sai hoặc user không tồn tại\n    AuthRouter --&gt; Frontend: 400 Error\\n{INVALID_CREDENTIALS}\n    Frontend --&gt; User: Hiển thị thông báo lỗi\nend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="hRXB8u5-1j2GtJK3M20z-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1053" width="1151" x="-120" y="-50" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="G_oE4kgvX8e8wlVDKjZ6" name="Page-15">
    <mxGraphModel dx="2230" dy="1999" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 14\n\nskinparam sequence {\n  ParticipantFontName \&quot;Times New Roman\&quot;\n  ParticipantFontSize 14\n  MessageFontName \&quot;Times New Roman\&quot;\n  TitleFontName \&quot;Times New Roman\&quot;\n}\n\n\nautonumber\n\nactor User\nparticipant \&quot;Frontend\&quot; as Frontend\nparticipant \&quot;Loans Router\\n(/api/loans)\&quot; as LoanRouter\nparticipant \&quot;LoanService\&quot; as LoanService\nparticipant \&quot;Policy\&quot; as Policy\nparticipant \&quot;Database\&quot; as DB\nparticipant \&quot;NotificationService\&quot; as NotifService\n\nUser -&gt; Frontend: Chọn bản sao và click \&quot;Mượn sách\&quot;\nFrontend -&gt; LoanRouter: POST /api/loans/request\\n{copy_id}\\n(Header: Bearer token)\nLoanRouter -&gt; DB: SELECT copy WHERE id = copy_id\nDB --&gt; LoanRouter: Copy data\n\nalt Copy không tồn tại hoặc không available\n    LoanRouter --&gt; Frontend: 400 Error\\n{COPY_NOT_AVAILABLE}\n    Frontend --&gt; User: Hiển thị thông báo lỗi\nelse Copy available\n    LoanRouter -&gt; LoanService: Kiểm tra số lượng sách đang mượn\n    LoanService -&gt; DB: SELECT COUNT(loans) WHERE user_id\\nAND status IN (requested, borrowed, return_requested)\n    DB --&gt; LoanService: current_loans count\n    LoanService -&gt; Policy: Lấy chính sách mượn\n    Policy -&gt; DB: SELECT policy WHERE loai_nguoi_dung\n    DB --&gt; Policy: Policy data (toi_da_muon)\n    Policy --&gt; LoanService: max_loans\n    \n    alt current_loans &gt;= max_loans\n        LoanService --&gt; LoanRouter: Error: Đã mượn tối đa\n        LoanRouter --&gt; Frontend: 400 Error\n        Frontend --&gt; User: Thông báo đã mượn tối đa\n    else\n        LoanService -&gt; DB: Kiểm tra đã mượn bản sao khác của cùng sách\n        DB --&gt; LoanService: has_same_book (true/false)\n        \n        alt has_same_book = true\n            LoanService --&gt; LoanRouter: Error: Đã mượn sách này\n            LoanRouter --&gt; Frontend: 400 Error\n            Frontend --&gt; User: Thông báo đã mượn sách này\n        else\n            LoanService -&gt; DB: INSERT INTO phieu_muon\\n(status=&#39;requested&#39;)\n            DB --&gt; LoanService: Loan created\n            LoanService -&gt; DB: UPDATE ban_sao SET trang_thai=&#39;reserved&#39;\n            DB --&gt; LoanService: Copy updated\n            LoanService -&gt; DB: COMMIT\n            LoanService --&gt; LoanRouter: {id, status}\n            \n            LoanRouter -&gt; NotifService: Gửi thông báo cho admin\n            NotifService -&gt; DB: SELECT users WHERE vai_tro=&#39;admin&#39;\n            DB --&gt; NotifService: Admin list\n            loop Cho mỗi admin\n                NotifService -&gt; DB: INSERT INTO thong_bao\\n(loan_request, title, body)\n            end\n            DB --&gt; NotifService: Notifications created\n            NotifService --&gt; LoanRouter: Done\n            \n            LoanRouter --&gt; Frontend: {id, status: &#39;requested&#39;}\n            Frontend --&gt; User: Hiển thị thông báo thành công\n        end\n    end\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="UwGcICOVAzWXhS5fxcyC-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1430" width="1676" x="-420" y="-290" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="y0ya8FX3ApiRwthdvFyw" name="Page-16">
    <mxGraphModel dx="2831" dy="2355" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 14\n\nskinparam sequence {\n  ParticipantFontName \&quot;Times New Roman\&quot;\n  ParticipantFontSize 14\n  MessageFontName \&quot;Times New Roman\&quot;\n  TitleFontName \&quot;Times New Roman\&quot;\n}\n\n\nautonumber\n\nactor Admin\nparticipant \&quot;Frontend Admin\&quot; as Frontend\nparticipant \&quot;Loans Router\\n(/api/admin/loans)\&quot; as LoanRouter\nparticipant \&quot;LoanService\&quot; as LoanService\nparticipant \&quot;Policy\&quot; as Policy\nparticipant \&quot;Database\&quot; as DB\nparticipant \&quot;NotificationService\&quot; as NotifService\n\nAdmin -&gt; Frontend: Xem danh sách yêu cầu mượn\nFrontend -&gt; LoanRouter: GET /api/admin/loans?status=requested\nLoanRouter -&gt; DB: SELECT loans WHERE status=&#39;requested&#39;\\nJOIN users, copies, books\nDB --&gt; LoanRouter: Loans list\nLoanRouter --&gt; Frontend: List of requested loans\nFrontend --&gt; Admin: Hiển thị danh sách\n\nAdmin -&gt; Frontend: Chọn một yêu cầu và click \&quot;Duyệt\&quot;\nFrontend -&gt; Frontend: Hiển thị dialog nhập hạn trả\nAdmin -&gt; Frontend: Nhập ngày hạn trả (hoặc dùng mặc định)\nFrontend -&gt; LoanRouter: POST /api/admin/loans/{loan_id}/approve\\n{due_at}\n\nLoanRouter -&gt; DB: SELECT loan WHERE id = loan_id\nDB --&gt; LoanRouter: Loan data\n\nalt Loan không tồn tại hoặc không ở trạng thái &#39;requested&#39;\n    LoanRouter --&gt; Frontend: 400 Error\\n{BAD_STATE}\n    Frontend --&gt; Admin: Thông báo lỗi\nelse\n    LoanRouter -&gt; DB: SELECT copy WHERE id = loan.id_ban_sao\n    DB --&gt; LoanRouter: Copy data\n    \n    LoanRouter -&gt; DB: SELECT user WHERE id = loan.id_nguoi_dung\n    DB --&gt; LoanRouter: User data (loai_nguoi_dung)\n    \n    LoanRouter -&gt; Policy: Lấy số ngày mượn tối đa\n    Policy -&gt; DB: SELECT policy WHERE loai_nguoi_dung\n    DB --&gt; Policy: Policy data (so_ngay_muon)\n    Policy --&gt; LoanRouter: max_days\n    \n    LoanRouter -&gt; LoanService: Kiểm tra hạn trả không vượt quá max_days\n    LoanService -&gt; LoanService: Tính (due_date - borrow_date).days\n    \n    alt (due_date - borrow_date).days &gt; max_days\n        LoanService --&gt; LoanRouter: Error: Hạn trả vượt quá\n        LoanRouter --&gt; Frontend: 400 Error\n        Frontend --&gt; Admin: Thông báo hạn trả vượt quá\n    else\n        LoanService -&gt; DB: UPDATE phieu_muon SET\\nstatus=&#39;borrowed&#39;,\\nnguoi_duyet=admin_id,\\nduyet_luc=NOW(),\\nmuon_luc=NOW(),\\nhan_tra=due_at\n        DB --&gt; LoanService: Loan updated\n        LoanService -&gt; DB: UPDATE ban_sao SET trang_thai=&#39;on_loan&#39;\n        DB --&gt; LoanService: Copy updated\n        LoanService -&gt; DB: COMMIT\n        LoanService --&gt; LoanRouter: Success\n        \n        LoanRouter -&gt; NotifService: Gửi thông báo cho người mượn\n        NotifService -&gt; DB: INSERT INTO thong_bao\\n(loan_approved, title, body)\n        DB --&gt; NotifService: Notification created\n        NotifService --&gt; LoanRouter: Done\n        \n        LoanRouter --&gt; Frontend: {id, status: &#39;borrowed&#39;}\n        Frontend --&gt; Admin: Hiển thị thông báo thành công\n    end\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="i861MyRIIfg6CqdlJvfd-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1538" width="1899" x="-540" y="-340" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bIprxQzKkC6xSlWT-IFb" name="Page-17">
    <mxGraphModel dx="2230" dy="1999" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 14\n\nskinparam sequence {\n  ParticipantFontName \&quot;Times New Roman\&quot;\n  ParticipantFontSize 14\n  MessageFontName \&quot;Times New Roman\&quot;\n  TitleFontName \&quot;Times New Roman\&quot;\n}\n\n\nautonumber\n\nactor User\nparticipant \&quot;Frontend\&quot; as Frontend\nparticipant \&quot;Loans Router\&quot; as LoanRouter\nparticipant \&quot;LoanService\&quot; as LoanService\nparticipant \&quot;Policy\&quot; as Policy\nparticipant \&quot;Database\&quot; as DB\nparticipant \&quot;NotificationService\&quot; as NotifService\nactor Admin\n\n== User yêu cầu trả sách ==\nUser -&gt; Frontend: Xem danh sách phiếu mượn\nFrontend -&gt; LoanRouter: GET /api/me/loans\\n(Header: Bearer token)\nLoanRouter -&gt; DB: SELECT loans WHERE user_id\\nAND status=&#39;borrowed&#39;\nDB --&gt; LoanRouter: User&#39;s loans\nLoanRouter --&gt; Frontend: Loans list\nFrontend --&gt; User: Hiển thị danh sách\n\nUser -&gt; Frontend: Click \&quot;Yêu cầu trả sách\&quot; trên một phiếu\nFrontend -&gt; LoanRouter: POST /api/loans/{loan_id}/request-return\nLoanRouter -&gt; DB: SELECT loan WHERE id = loan_id\\nAND user_id = current_user\nDB --&gt; LoanRouter: Loan data\n\nalt Loan không tồn tại hoặc không ở trạng thái &#39;borrowed&#39;\n    LoanRouter --&gt; Frontend: 400 Error\\n{BAD_STATE}\n    Frontend --&gt; User: Thông báo lỗi\nelse\n    LoanRouter -&gt; DB: UPDATE phieu_muon SET\\nstatus=&#39;return_requested&#39;,\\nyeu_cau_tra_luc=NOW()\n    DB --&gt; LoanRouter: Loan updated\n    LoanRouter -&gt; DB: COMMIT\n    \n    LoanRouter -&gt; NotifService: Gửi thông báo cho admin\n    NotifService -&gt; DB: SELECT users WHERE vai_tro=&#39;admin&#39;\n    DB --&gt; NotifService: Admin list\n    loop Cho mỗi admin\n        NotifService -&gt; DB: INSERT INTO thong_bao\\n(return_request, title, body)\n    end\n    DB --&gt; NotifService: Notifications created\n    \n    LoanRouter --&gt; Frontend: {id, status: &#39;return_requested&#39;}\n    Frontend --&gt; User: Thông báo thành công\nend\n\n== Admin duyệt trả sách ==\nAdmin -&gt; Frontend: Xem yêu cầu trả sách\nFrontend -&gt; LoanRouter: GET /api/admin/loans?status=return_requested\nLoanRouter -&gt; DB: SELECT loans WHERE status=&#39;return_requested&#39;\nDB --&gt; LoanRouter: Return requests\nLoanRouter --&gt; Frontend: List\nFrontend --&gt; Admin: Hiển thị danh sách\n\nAdmin -&gt; Frontend: Click \&quot;Duyệt trả\&quot;\nFrontend -&gt; LoanRouter: POST /api/admin/loans/{loan_id}/approve-return\n\nLoanRouter -&gt; DB: SELECT loan, copy, user WHERE loan_id\nDB --&gt; LoanRouter: Loan, Copy, User data\n\nLoanRouter -&gt; LoanService: Kiểm tra ngày trả vs hạn trả\nLoanService -&gt; LoanService: Tính số ngày trễ\n\nalt tra_luc &gt; han_tra (trả trễ)\n    LoanService -&gt; Policy: Lấy phạt mỗi ngày\n    Policy -&gt; DB: SELECT policy WHERE loai_nguoi_dung\n    DB --&gt; Policy: Policy data (phat_moi_ngay)\n    Policy --&gt; LoanService: fine_per_day\n    \n    LoanService -&gt; LoanService: Tính tiền phạt\\n= days_late × fine_per_day\n    LoanService -&gt; DB: UPDATE phieu_muon SET\\nstatus=&#39;returned&#39;,\\ntra_luc=NOW(),\\nso_tien_phat=calculated_fine,\\nnoi_dung_phat=&#39;Trả trễ X ngày&#39;\nelse\n    LoanService -&gt; DB: UPDATE phieu_muon SET\\nstatus=&#39;returned&#39;,\\ntra_luc=NOW(),\\nso_tien_phat=0\nend\n\nDB --&gt; LoanService: Loan updated\nLoanService -&gt; DB: UPDATE ban_sao SET trang_thai=&#39;available&#39;\nDB --&gt; LoanService: Copy updated\nLoanService -&gt; DB: COMMIT\nLoanService --&gt; LoanRouter: Success\n\nalt Có tiền phạt\n    LoanRouter -&gt; NotifService: Gửi thông báo phạt cho user\n    NotifService -&gt; DB: INSERT INTO thong_bao\\n(loan_fined, title, body với số tiền phạt)\nelse\n    LoanRouter -&gt; NotifService: Gửi thông báo trả sách thành công\n    NotifService -&gt; DB: INSERT INTO thong_bao\\n(loan_returned, title, body)\nend\nDB --&gt; NotifService: Notification created\n\nLoanRouter --&gt; Frontend: {id, status: &#39;returned&#39;}\nFrontend --&gt; Admin: Thông báo thành công\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="7D7JmQl2bfKCYjWvjjHG-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="2218" width="1969" x="-570" y="-680" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="GNUkeoqNPmYcLSsLR16K" name="Page-18">
    <mxGraphModel dx="2230" dy="1999" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 14\n\nskinparam sequence {\n  ParticipantFontName \&quot;Times New Roman\&quot;\n  ParticipantFontSize 14\n  MessageFontName \&quot;Times New Roman\&quot;\n  TitleFontName \&quot;Times New Roman\&quot;\n}\n\n\nautonumber\n\nactor Admin\nparticipant \&quot;Frontend Admin\&quot; as Frontend\nparticipant \&quot;Books Router\\n(/api/books)\&quot; as BookRouter\nparticipant \&quot;BookService\&quot; as BookService\nparticipant \&quot;Publishers Router\&quot; as PubRouter\nparticipant \&quot;Database\&quot; as DB\n\nAdmin -&gt; Frontend: Vào trang quản lý sách\nFrontend -&gt; BookRouter: GET /api/books?page=1&amp;limit=20\nBookRouter -&gt; DB: SELECT books JOIN publishers\nDB --&gt; BookRouter: Books list\nBookRouter --&gt; Frontend: {items, page, limit, total}\nFrontend --&gt; Admin: Hiển thị danh sách sách\n\nAdmin -&gt; Frontend: Click \&quot;Thêm sách mới\&quot;\nFrontend -&gt; Frontend: Hiển thị form thêm sách\n\nAdmin -&gt; Frontend: Điền thông tin sách\\n(tiêu đề, tác giả, NXB, năm XB, thể loại, mô tả, giá bìa)\nAdmin -&gt; Frontend: Upload ảnh sách (nhiều ảnh, chọn ảnh đại diện)\nFrontend -&gt; Frontend: Validate dữ liệu\n\nalt NXB chưa tồn tại\n    Frontend -&gt; PubRouter: POST /api/publishers\\n{name, address, website, note}\n    PubRouter -&gt; DB: INSERT INTO nha_xuat_ban\n    DB --&gt; PubRouter: Publisher created\n    PubRouter --&gt; Frontend: {id, name}\n    Frontend -&gt; Frontend: Lưu publisher_id\nend\n\nFrontend -&gt; BookRouter: POST /api/books\\n{title, authors, publisher_id, pub_year, the_loai, mo_ta, gia_bia, currency}\nBookRouter -&gt; BookService: Validate và tạo sách\nBookService -&gt; DB: INSERT INTO sach\\n(tieu_de, tac_gia, id_nxb, nam_xb, the_loai, mo_ta, gia_bia)\nDB --&gt; BookService: Book created (id)\nBookService -&gt; DB: COMMIT\n\nloop Cho mỗi ảnh\n    BookService -&gt; DB: INSERT INTO anh_sach\\n(id_sach, url_anh, la_anh_dai_dien, thu_tu)\nend\nDB --&gt; BookService: Images created\nBookService -&gt; DB: COMMIT\n\nBookService --&gt; BookRouter: {id}\nBookRouter --&gt; Frontend: {id}\nFrontend --&gt; Admin: Hiển thị thông báo thành công\nFrontend -&gt; BookRouter: GET /api/books (refresh list)\nBookRouter -&gt; DB: SELECT books\nDB --&gt; BookRouter: Updated list\nBookRouter --&gt; Frontend: Books list\nFrontend --&gt; Admin: Hiển thị danh sách đã cập nhật\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="4xArcObQruiU3fXlxiuV-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1284" width="1743" x="-460" y="-210" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="3UrPg4emJeB-N7SWt-FD" name="Page-19">
    <mxGraphModel dx="2230" dy="1999" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 14\n\nskinparam sequence {\n  ParticipantFontName \&quot;Times New Roman\&quot;\n  ParticipantFontSize 14\n  MessageFontName \&quot;Times New Roman\&quot;\n  TitleFontName \&quot;Times New Roman\&quot;\n}\n\nautonumber\n\nactor Admin\nparticipant \&quot;Frontend Admin\&quot; as Frontend\nparticipant \&quot;Reports Router\\n(/api/admin/reports)\&quot; as ReportRouter\nparticipant \&quot;Database\&quot; as DB\n\nAdmin -&gt; Frontend: Vào trang báo cáo\nFrontend -&gt; ReportRouter: GET /api/admin/reports/overview\nReportRouter -&gt; DB: SELECT COUNT(*) FROM sach\nDB --&gt; ReportRouter: total_books\nReportRouter -&gt; DB: SELECT COUNT(*) FROM ban_sao\nDB --&gt; ReportRouter: total_copies\nReportRouter -&gt; DB: SELECT COUNT(*) FROM nguoi_dung\nDB --&gt; ReportRouter: total_users\nReportRouter -&gt; DB: SELECT COUNT(*) FROM phieu_muon\nDB --&gt; ReportRouter: total_loans\nReportRouter -&gt; DB: SELECT COUNT(*) FROM phieu_muon WHERE status=&#39;returned&#39;\nDB --&gt; ReportRouter: total_returns\nReportRouter -&gt; DB: SELECT COUNT(*) FROM phieu_muon WHERE status=&#39;overdue&#39;\nDB --&gt; ReportRouter: total_overdue\n\nReportRouter -&gt; ReportRouter: Tính tổng tiền phạt\\n(Lặp qua các loan quá hạn/trả trễ,\\ntính số ngày trễ × phạt mỗi ngày theo Policy)\nReportRouter --&gt; Frontend: {total_books, total_copies, total_users,\\ntotal_loans, total_returns, total_overdue, total_fines}\nFrontend --&gt; Admin: Hiển thị tổng quan\n\nAdmin -&gt; Frontend: Chọn \&quot;Top sách mượn nhiều\&quot;\nFrontend -&gt; ReportRouter: GET /api/admin/reports/top-books?from=...&amp;to=...&amp;limit=10\nReportRouter -&gt; DB: SELECT book_id, COUNT(loan_id) as loan_count\\nFROM loans JOIN copies ON loans.id_ban_sao = copies.id\\nWHERE muon_luc BETWEEN from AND to\\nGROUP BY book_id\\nORDER BY loan_count DESC\\nLIMIT 10\nDB --&gt; ReportRouter: Top books data\nReportRouter --&gt; Frontend: [{id, title, authors, loan_count}, ...]\nFrontend --&gt; Admin: Hiển thị biểu đồ/bảng top sách\n\nAdmin -&gt; Frontend: Chọn \&quot;Thống kê mượn/trả theo tháng\&quot;\nFrontend -&gt; ReportRouter: GET /api/admin/reports/loans-by-month?from=...&amp;to=...\nReportRouter -&gt; DB: SELECT DATE_FORMAT(muon_luc, &#39;%Y-%m&#39;) as month,\\nCOUNT(*) as borrow_count\\nFROM phieu_muon\\nWHERE muon_luc BETWEEN from AND to\\nGROUP BY month\nDB --&gt; ReportRouter: Borrow by month\nReportRouter -&gt; DB: SELECT DATE_FORMAT(tra_luc, &#39;%Y-%m&#39;) as month,\\nCOUNT(*) as return_count\\nFROM phieu_muon\\nWHERE tra_luc BETWEEN from AND to\\nGROUP BY month\nDB --&gt; ReportRouter: Return by month\nReportRouter -&gt; ReportRouter: Gộp dữ liệu mượn và trả theo tháng\nReportRouter --&gt; Frontend: [{month, borrow_count, return_count}, ...]\nFrontend --&gt; Admin: Hiển thị biểu đồ đường mượn/trả theo tháng\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="oXzXmX48qx0CtHJQ7ZdS-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1374" width="1275" x="-220" y="-260" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
