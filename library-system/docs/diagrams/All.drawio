  <diagram id="H5Zsx3lvb094NC2JyAdo" name="Page-11">
    <mxGraphModel dx="4205" dy="2678" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nskinparam classAttributeIconSize 0\n\npackage \&quot;Authentication Module\&quot; {\n  class User {\n    -BigInteger id\n    -String email\n    -String mat_khau_hash\n    -String ho_ten\n    -Enum vai_tro\n    -Enum loai_nguoi_dung\n    -Boolean hoat_dong\n    -DateTime tao_luc\n    -String so_dien_thoai\n    -String dia_chi\n  }\n  \n  class AuthService {\n    +hash_password(password: str): str\n    +verify_password(plain: str, hash: str): bool\n    +create_access_token(user_id, role, user_type): str\n    +create_refresh_token(user_id, role, user_type): str\n    +decode_token(token: str): dict\n  }\n  \n  class CurrentUser {\n    +int user_id\n    +str role\n    +str email\n    +str user_type\n    +str full_name\n  }\n}\n\npackage \&quot;Book Management Module\&quot; {\n  class Book {\n    -BigInteger id\n    -Text tieu_de\n    -Text tieu_de_phu\n    -Text tac_gia\n    -BigInteger id_nxb\n    -Integer nam_xb\n    -String ngon_ngu\n    -Text the_loai\n    -Text mo_ta\n    -DECIMAL gia_bia\n    -String don_vi_tien\n    -Integer so_luong_tong\n    -Integer so_luong_con\n    +relationship publisher\n  }\n  \n  class Publisher {\n    -BigInteger id\n    -String ten\n    -String dia_chi\n    -String website\n    -Text ghi_chu\n    +relationship books\n  }\n  \n  class BookImage {\n    -BigInteger id\n    -BigInteger id_sach\n    -Text url_anh\n    -Boolean la_anh_dai_dien\n    -Integer thu_tu\n  }\n  \n  class BookService {\n    +list_books(search, filters, page, limit): BookListResponse\n    +get_book_detail(book_id): BookDetailResponse\n    +create_book(data: BookCreate): Book\n    +update_book(book_id, data: BookUpdate): Book\n    +delete_book(book_id): bool\n  }\n}\n\npackage \&quot;Copy Management Module\&quot; {\n  class Copy {\n    -BigInteger id\n    -BigInteger id_sach\n    -String ma_ban_sao\n    -BigInteger id_vi_tri\n    -Enum trang_thai\n    -DateTime tao_luc\n    -DateTime cap_nhat_luc\n  }\n  \n  class Location {\n    -BigInteger id\n    -String ma_ke\n    -String tang\n    -String phong\n    -String ke\n    -String hang\n    -String cot\n    -Text ghi_chu\n  }\n  \n  class CopyService {\n    +list_copies(filters, page, limit): CopyListResponse\n    +get_copy_by_code(code): CopyLookupOut\n    +create_copy(data: CopyCreate): Copy\n    +update_copy(copy_id, data: CopyPatch): Copy\n  }\n}\n\npackage \&quot;Loan Management Module\&quot; {\n  class Loan {\n    -BigInteger id\n    -BigInteger id_ban_sao\n    -BigInteger id_nguoi_dung\n    -Enum trang_thai\n    -Text ly_do_tu_choi\n    -BigInteger nguoi_duyet\n    -DateTime duyet_luc\n    -DateTime muon_luc\n    -DateTime han_tra\n    -DateTime yeu_cau_tra_luc\n    -BigInteger nguoi_duyet_tra\n    -DateTime tra_luc\n    -Numeric so_tien_phat\n    -Text noi_dung_phat\n    -Boolean da_nop_phat\n    -DateTime ngay_nop_phat\n    -BigInteger admin_xac_nhan_phat\n    -DateTime tao_luc\n  }\n  \n  class Policy {\n    -BigInteger id\n    -Enum loai_nguoi_dung\n    -Integer toi_da_muon\n    -Integer so_ngay_muon\n    -Numeric phat_moi_ngay\n    -Integer so_lan_gia_han\n  }\n  \n  class LoanService {\n    +request_loan(user, copy_id): Loan\n    +request_return(user, loan_id): Loan\n    +list_my_loans(user, status): List[Loan]\n    +admin_approve_loan(admin, loan_id, due_at): Loan\n    +admin_reject_loan(admin, loan_id, reason): Loan\n    +admin_approve_return(admin, loan_id): Loan\n    +calculate_fine(loan): Numeric\n  }\n}\n\npackage \&quot;Notification Module\&quot; {\n  class Notification {\n    -BigInteger id\n    -BigInteger id_nguoi_dung\n    -String loai\n    -Text tieu_de\n    -Text noi_dung\n    -Boolean da_doc\n    -DateTime tao_luc\n  }\n  \n  class NotificationService {\n    +list_notifications(user): List[Notification]\n    +get_unread_count(user): int\n    +mark_read(notification_id, user): Notification\n    +mark_all_read(user): int\n    +create_notification(user_id, type, title, body): Notification\n    +broadcast_notification(user_ids, type, title, body): List[Notification]\n    +send_system_notification(user_type, type, title, body): List[Notification]\n  }\n}\n\npackage \&quot;System Module\&quot; {\n  class Setting {\n    -String khoa\n    -Text gia_tri\n  }\n  \n  class Rule {\n    -BigInteger id\n    -String tieu_de\n    -Text mo_ta\n    -Enum danh_muc\n    -Enum trang_thai\n    -Enum muc_do\n    -Enum doi_tuong\n    -Date ngay_hieu_luc\n    -Date ngay_het_hieu_luc\n    -Numeric so_tien_phat\n    -Enum loai_phat\n    -String don_vi_tien\n    -String nguoi_tao\n    -String nguoi_cap_nhat\n    -DateTime tao_luc\n    -DateTime cap_nhat_luc\n  }\n}\n\npackage \&quot;Database\&quot; {\n  class Base {\n    &lt;&lt;abstract&gt;&gt;\n  }\n  \n  class SessionLocal {\n    +get_db(): Session\n  }\n}\n\n&#39; Relationships\nUser \&quot;1\&quot; --&gt; \&quot;*\&quot; Loan : mượn\nCopy \&quot;1\&quot; --&gt; \&quot;*\&quot; Loan : được mượn\nBook \&quot;1\&quot; --&gt; \&quot;*\&quot; Copy : có bản sao\nBook \&quot;1\&quot; --&gt; \&quot;*\&quot; BookImage : có ảnh\nPublisher \&quot;1\&quot; --&gt; \&quot;*\&quot; Book : xuất bản\nLocation \&quot;1\&quot; --&gt; \&quot;*\&quot; Copy : chứa\nUser \&quot;1\&quot; --&gt; \&quot;*\&quot; Notification : nhận\nBook --&gt; Publisher : thuộc về\nLoan --&gt; Policy : áp dụng chính sách\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="OZ19YshyLSiOblxn9mC2-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1260" width="2822" x="-940" y="-230" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
