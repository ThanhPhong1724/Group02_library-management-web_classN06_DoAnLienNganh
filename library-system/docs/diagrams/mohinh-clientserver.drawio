<mxfile host="app.diagrams.net">
  <diagram id="client-server-model" name="Client-Server Model">
    <mxGraphModel dx="1422" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="Mô hình Client-Server" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="40" as="geometry" />
        </mxCell>
        
        <!-- CLIENT -->
        <mxCell id="client-box" value="CLIENT" style="swimlane;html=1;startSize=30;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="580" height="480" as="geometry" />
        </mxCell>
        
        <!-- Presentation Layer -->
        <mxCell id="presentation-layer" value="Presentation Layer" style="swimlane;html=1;startSize=25;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="client-box">
          <mxGeometry x="20" y="50" width="540" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="presentation-item1" value="• UI Components (React, shadcn/ui)&#xa;• Pages &amp; Layouts&#xa;• Forms &amp; Validation&#xa;• Charts &amp; Visualizations" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="presentation-layer">
          <mxGeometry x="20" y="40" width="500" height="130" as="geometry" />
        </mxCell>
        
        <!-- Application Logic Layer -->
        <mxCell id="app-logic-layer" value="Application Logic Layer" style="swimlane;html=1;startSize=25;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="client-box">
          <mxGeometry x="20" y="250" width="540" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="app-logic-item1" value="• State Management (Context API)&#xa;• API Client&#xa;• Routing (Next.js App Router)&#xa;• Authentication Context" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="app-logic-layer">
          <mxGeometry x="20" y="40" width="500" height="150" as="geometry" />
        </mxCell>
        
        <!-- Arrow from Presentation to App Logic -->
        <mxCell id="arrow-presentation-app" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="client-box" source="presentation-layer" target="app-logic-layer">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="300" y="300" as="sourcePoint" />
            <mxPoint x="350" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- SERVER -->
        <mxCell id="server-box" value="SERVER" style="swimlane;html=1;startSize=30;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="740" y="80" width="580" height="480" as="geometry" />
        </mxCell>
        
        <!-- API Layer -->
        <mxCell id="api-layer" value="API Layer (FastAPI)" style="swimlane;html=1;startSize=25;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="server-box">
          <mxGeometry x="20" y="50" width="540" height="130" as="geometry" />
        </mxCell>
        
        <mxCell id="api-item1" value="• RESTful Endpoints&#xa;• Request/Response Handling&#xa;• Authentication Middleware&#xa;• CORS Middleware&#xa;• Error Handling" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="api-layer">
          <mxGeometry x="20" y="40" width="500" height="80" as="geometry" />
        </mxCell>
        
        <!-- Business Logic Layer -->
        <mxCell id="business-layer" value="Business Logic Layer" style="swimlane;html=1;startSize=25;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="server-box">
          <mxGeometry x="20" y="200" width="540" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="business-item1" value="• Service Classes&#xa;• Business Rules&#xa;• Data Validation (Pydantic)&#xa;• Loan Management Logic&#xa;• Fine Calculation&#xa;• Notification Service" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="business-layer">
          <mxGeometry x="20" y="40" width="500" height="100" as="geometry" />
        </mxCell>
        
        <!-- Data Access Layer -->
        <mxCell id="data-access-layer" value="Data Access Layer (SQLAlchemy ORM)" style="swimlane;html=1;startSize=25;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1" vertex="1" parent="server-box">
          <mxGeometry x="20" y="370" width="540" height="90" as="geometry" />
        </mxCell>
        
        <mxCell id="data-access-item1" value="• Models (User, Book, Copy, Loan, etc.)&#xa;• Database Queries&#xa;• Relationships&#xa;• Transactions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="data-access-layer">
          <mxGeometry x="20" y="40" width="500" height="40" as="geometry" />
        </mxCell>
        
        <!-- Arrows within Server -->
        <mxCell id="arrow-api-business" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="server-box" source="api-layer" target="business-layer">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1000" y="300" as="sourcePoint" />
            <mxPoint x="1050" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow-business-data" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="server-box" source="business-layer" target="data-access-layer">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1000" y="450" as="sourcePoint" />
            <mxPoint x="1050" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- DATABASE -->
        <mxCell id="database-box" value="DATABASE (MySQL)" style="swimlane;html=1;startSize=30;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="600" width="400" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="db-item1" value="• Tables &amp; Relationships&#xa;• Triggers &amp; Views&#xa;• Indexes &amp; Constraints" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="database-box">
          <mxGeometry x="20" y="40" width="360" height="70" as="geometry" />
        </mxCell>
        
        <!-- Communication Flow Arrows -->
        <mxCell id="arrow-client-server" value="HTTP/HTTPS&#xa;REST API&#xa;JSON Data&#xa;JWT Token" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelPosition=center;verticalLabelPosition=middle;align=center;verticalAlign=middle;strokeWidth=2;" edge="1" parent="1" source="client-box" target="server-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="700" y="350" as="sourcePoint" />
            <mxPoint x="750" y="300" as="targetPoint" />
            <Array as="points">
              <mxPoint x="680" y="340" />
              <mxPoint x="740" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow-server-db" value="SQL Queries" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelPosition=center;verticalLabelPosition=middle;align=center;verticalAlign=middle;" edge="1" parent="1" source="server-box" target="database-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1000" y="700" as="sourcePoint" />
            <mxPoint x="1050" y="650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- Communication Flow Label -->
        <mxCell id="flow-label" value="Communication Flow:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="760" width="200" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-item1" value="1. Client sends HTTP request with JWT token" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="800" width="600" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-item2" value="2. Server validates token and processes request" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="830" width="600" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-item3" value="3. Server queries database through ORM" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="860" width="600" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-item4" value="4. Server returns JSON response" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="890" width="600" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-item5" value="5. Client updates UI based on response" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="920" width="600" height="20" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
